<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="@color/white"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:theme="@style/ThemeOverlay.AppCompat.Light">

    <!-- Profile image and FAQ icon row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal">

        <!-- User Profile Image -->
        <ImageView
            android:id="@+id/userProfileImage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="15dp"
            android:contentDescription="@string/nav_header_desc"
            android:scaleType="centerCrop"
            app:srcCompat="@mipmap/ic_launcher_foreground" />

        <!-- Spacer to push FAQ icon to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- FAQ Image aligned to the right -->
        <ImageView
            android:id="@+id/faqImage"
            android:layout_width="20dp"
            android:layout_height="30dp"
            android:layout_marginEnd="20dp"
            android:paddingTop="10dp"
            android:contentDescription="@string/nav_header_desc"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_faq" />
    </LinearLayout>

    <!-- User name and username texts -->
    <TextView
        android:id="@+id/profileName"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:paddingTop="@dimen/nav_header_vertical_spacing"
        android:text="User Name"
        android:layout_marginStart="20dp"
        android:fontFamily=""
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/profileUsername"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:paddingTop="@dimen/nav_header_vertical_spacing"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"
        android:text="Layout for API 29"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/black"
        android:textStyle="italic"
        android:textSize="15sp"
      />
    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"
        android:background="@color/lightgray" />

</LinearLayout>
