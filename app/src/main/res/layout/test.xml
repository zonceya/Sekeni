<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/productImages"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:src="@drawable/nike_shoe" />

        <!-- Product Title -->
        <TextView
            android:id="@+id/productTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Relaxed fit linen resort shirt - blue"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="8dp" />

        <!-- Brand Name -->
        <TextView
            android:id="@+id/brandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By HM"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <!-- Payment Options -->
        <TextView
            android:id="@+id/paymentOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get it now, pay later"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/paymentDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pay using credit options, Payflex, PayJustNow, Mobicred or RCS."
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <!-- Size Selection -->
        <TextView
            android:id="@+id/sizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a size"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <LinearLayout
            android:id="@+id/sizeOptionsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp">


            <!-- Size Option M -->
            <TextView
                android:id="@+id/sizeM"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="M"
                android:background="@drawable/size_selector"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_margin="8dp" />


        </LinearLayout>

        <!-- More Options -->
        <TextView
            android:id="@+id/moreOptionsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More options"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/nikehoodie2" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/hoodie_nike" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/adidas_hoodie" />
        </LinearLayout>

        <!-- Shipping Info -->
        <TextView
            android:id="@+id/shippingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shipping"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/shippingDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FREE Standard delivery on orders over R650.\nFREE Collection on orders over R650."
            android:textSize="14sp"
            android:paddingTop="4dp" />

        <!-- Price and Add to Cart Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R429"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginEnd="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/addToCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="Add To Cart"
                android:backgroundTint="@color/black"
                android:textStyle="bold"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
